<Window
    x:Class="HMICore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="GVA HMI Core — 1920 × 1080"
    Width="1720"
    Height="1080"
    MinWidth="640"
    MinHeight="380"
    AllowsTransparency="True"
    Background="Transparent"
    MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
    ResizeMode="CanResize"
    TextOptions.TextFormattingMode="Ideal"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <!--
        AllowsTransparency="True" + Background="Transparent" 인 이유 : Application
        영역(1590x915)을 창에서 비워 그 자리로 뒤가 비치게 하되, 그 위에 Core 가
        WPF 엘리먼트를 얹을 수 있어야 한다. Win32 윈도우 리전(SetWindowRgn)은
        그 자리 픽셀을 아예 잘라내므로 얹은 엘리먼트까지 같이 사라져서 못 쓴다.

        대가 : AllowsTransparency 는 창 전체를 소프트웨어 렌더링으로 떨어뜨린다.
        1920x1080 전면 UI 에서는 싸지 않지만, 위 요구사항과 맞바꾼 값이다.

        실제로 뚫리는 자리는 Controls/CoreUiBuilder.cs 의 배경판이 정한다 - 창은
        전부 투명이고, 그 위에 "캔버스 전체 - Application 영역" 모양으로 칠한다.

        WindowChrome 은 이제 테두리 드래그 리사이즈용으로만 남는다.
        - CaptionHeight=0       : 제목표시줄 없음(드래그는 OnWindowMouseLeftButtonDown)
        - ResizeBorderThickness : 테두리 드래그 리사이즈는 그대로 유지
        - GlassFrameThickness=0 : 레이어드 창이라 글래스 프레임은 원래 안 생기지만,
                                  WindowStyle 을 되돌릴 때를 대비해 0 으로 못박아 둔다.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="gd_main" />
</Window>
