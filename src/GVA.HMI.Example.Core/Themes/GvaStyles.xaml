<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:HMICore.Controls">

    <Style x:Key="GvaTextBase" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource GvaFont}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="StatusLabelStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="BaselineOffset" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatusValueStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource GvaMonoFont}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="BaselineOffset" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>

    <Style x:Key="CustomValueStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="BaselineOffset" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>

    <Style x:Key="TallyStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource GvaMonoFont}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="BaselineOffset" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SideSoftButtonStyle" TargetType="{x:Type ctl:SoftButton}">
        <Setter Property="Width" Value="153"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="FontFamily" Value="{StaticResource GvaFont}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:SoftButton}">
                    <Grid>
                        <Border x:Name="Root"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="{StaticResource SurfaceEnableBrush}">
                            <Grid Margin="8">
                                <TextBlock x:Name="KeyIdText"
                                           Text="{TemplateBinding KeyId}"
                                           FontFamily="{StaticResource GvaMonoFont}"
                                           FontSize="18"
                                           Foreground="{StaticResource ForegroundDimBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"/>

                                <TextBlock x:Name="LabelText"
                                           Text="{TemplateBinding Label}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           LineHeight="22" LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="44"
                                           TextAlignment="Left"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                           Margin="0,31,0,0"/>
                            </Grid>
                        </Border>

                        <Border x:Name="Highlight"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="{StaticResource SoftKeyHighlightCornerRadius}"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"/>

                        <Border x:Name="Engrave"
                                BorderBrush="{StaticResource EngraveBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"/>

                        <Border x:Name="AccentEdge"
                                Width="3" HorizontalAlignment="Left"
                                Margin="2,6,0,6"
                                CornerRadius="2"
                                Background="{StaticResource AccentBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"/>

                        <Border x:Name="DisabledHatch"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="{StaticResource DisabledHatchBrush}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>

                        <Border x:Name="Overlay"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="#FFFFFF" Opacity="0"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="SoftButtonSelected">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceSelectedBrush}"/>
                            <Setter TargetName="KeyIdText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="AccentEdge" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
                        </Trigger>

                        <Trigger Property="State" Value="SoftButtonDisabled">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceOffBrush}"/>
                            <Setter TargetName="KeyIdText" Property="Foreground" Value="{StaticResource ForegroundOffBrush}"/>
                            <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Engrave" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DisabledHatch" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundOffBrush}"/>
                        </Trigger>

                        <Trigger Property="State" Value="SoftButtonHidden">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="State" Value="SoftButtonEnabled"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.05"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="State" Value="SoftButtonSelected"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.06"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="State" Value="SoftButtonEnabled"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

