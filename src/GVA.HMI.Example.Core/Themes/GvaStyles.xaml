    <Style x:Key="TopLabelStyle" TargetType="{x:Type ctl:TopLabel}">
        <Setter Property="Width" Value="183"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:TopLabel}">
                    <Grid>
                        <Border Background="Transparent"/>

                        <Grid Height="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="LeftHalf" Grid.Column="0"
                                    CornerRadius="{StaticResource TopLabelLeftCornerRadius}"
                                    Background="{StaticResource LabelEnabledBrush}"/>
                            <Border x:Name="RightHalf" Grid.Column="1"
                                    CornerRadius="{StaticResource TopLabelRightCornerRadius}"
                                    Background="{StaticResource LabelEnabledBrush}"/>
                        </Grid>

                        <Border x:Name="DisabledHatch"
                                Height="6" VerticalAlignment="Center"
                                CornerRadius="{StaticResource FunctionLabelCornerRadius}"
                                Background="{StaticResource DisabledHatchBrush}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="LabelStateSelected">
                            <Setter TargetName="LeftHalf" Property="Background" Value="{StaticResource LabelSelectedBrush}"/>
                            <Setter TargetName="RightHalf" Property="Background" Value="{StaticResource LabelSelectedBrush}"/>
                        </Trigger>

                        <Trigger Property="State" Value="LabelStateSelectedLeft">
                            <Setter TargetName="LeftHalf" Property="Background" Value="{StaticResource LabelSelectedBrush}"/>
                        </Trigger>

                        <Trigger Property="State" Value="LabelStateSeletedRight">
                            <Setter TargetName="RightHalf" Property="Background" Value="{StaticResource LabelSelectedBrush}"/>
                        </Trigger>

                        <!-- SoftButton 의 disable 과 달리 여기엔 Opacity 0.5 가 더 걸려 있었다.
                             검은 캔버스 위에서 #141416 을 반투명으로 깔면 #0A0A0B 가 되어
                             사실상 사라진다 - 꺼진 게 아니라 없는 것처럼 보이던 원인. -->
                        <Trigger Property="State" Value="LabelStateDisabled">
                            <Setter TargetName="LeftHalf" Property="Background" Value="{StaticResource LabelDisabledBrush}"/>
                            <Setter TargetName="RightHalf" Property="Background" Value="{StaticResource LabelDisabledBrush}"/>
                            <Setter TargetName="DisabledHatch" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="State" Value="LabelStateEnabled"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LeftHalf" Property="Background" Value="{StaticResource ForegroundBrush}"/>
                            <Setter TargetName="RightHalf" Property="Background" Value="{StaticResource ForegroundBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
