<!--
    GVA HMI Core - 스타일

    "premium embedded HMI" 리디자인 (2번째 개편) :
    - 버튼 Effect(글로우/블러) 완전히 뺐다. Selected 표시는 배경 명도 변화 +
      3px 솔리드 액센트 엣지 하나로만 한다 - 네온/유리 효과 금지.
    - Disable 은 어둡게 죽이기만 하지 않고 대각선 해치(DisabledHatchBrush) 를
      겹쳐서 "사용 불가"를 명시적으로 표기한다.
    - 라운드를 줄였다(10→6, 5→3) - 과하게 둥글면 장난감처럼 보인다.
    - 내부 패딩/행 높이는 8px 그리드에 맞춘다.
    - 최소 폰트 18px 유지.

    렌더링 주의 : 이 앱은 1920x1080 을 그린 뒤 Viewbox 로 비정수 배율(예 0.667배)
    축소한다. Window 에 UseLayoutRounding="True" 나 여기 SnapsToDevicePixels="True"
    를 다시 걸면 CornerRadius 호가 축소 전 격자에 스냅되어 깨져 보인다
    (WPF 의 알려진 문제). 이 파일 전체에서 두 속성 모두 쓰지 않는다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:HMICore.Controls">

    <!-- ══════════════════════════════════════════════════════════
         공통 텍스트
    ══════════════════════════════════════════════════════════ -->

    <Style x:Key="GvaTextBase" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource GvaFont}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- StatusBar 라벨/값 - 18px 이 "너무 작다" 피드백으로 21px 로 올렸다.
         38px 행 안에서 여전히 여유 있게 들어간다. LineHeight 를 셋 다 똑같이
         고정해서(AlarmLevelTextStyle 과 동일한 26) 서로 다른 폰트/굵기를 나란히
         둬도 줄 높이가 안 어긋난다(CharacterSpacing 으로 자간을 벌리려 했으나
         이 WPF 런타임엔 그런 속성이 없어 뺐다). 값은 SemiBold 로 SoftButton
         라벨과 무게감을 맞췄다. -->
    <Style x:Key="StatusLabelStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="26"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 값 : 숫자/시각(시간·좌표·방위각)처럼 자릿수가 고정된 데이터만 mono 를 쓴다 -
         커스텀 전시정보처럼 임의의 한글/영문 단어가 오는 값은 CustomValueStyle(비-mono)
         을 대신 쓴다(mono 폰트엔 한글 글리프가 없어서 자동 대체 폰트로 튀어
         "숫자·영어·한글이 다 다른 느낌" 이 났었다). -->
    <Style x:Key="StatusValueStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource GvaMonoFont}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="26"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <!-- 커스텀 전시정보 값 전용 - StatusValueStyle 과 크기·굵기는 같지만 mono 가
         아니라 GvaFont(한글 폴백 포함, GvaColors.xaml)를 쓴다. -->
    <Style x:Key="CustomValueStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="26"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="TallyStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource GvaMonoFont}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="26"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         F1~F6 (좌측 레일) : 153 x 100
         F각인 우측 상단(전용 행) / 라벨 좌측정렬 최대 2줄, 남은 공간에서 세로중앙.
         F7~F12(우측 레일)는 라벨 우측정렬 + Selected 엣지 우측인
         SideSoftButtonRightStyle(바로 아래) 을 대신 쓴다.

         높이 90→100 : "F1~F12 최대한 키워봐" 피드백. 세로 피치(167.2)는 그대로
         두고(위치 Canvas.Top 은 안 바뀐다), 다음 버튼과의 간격이 67.2px 남아
         전혀 안 붙는다. 진짜 한계는 반대쪽 - F6/F12 아래로 하단 열(Y=1028)이
         있어서 100 이 8px 여백을 지키는 사실상 최댓값이다(101 이상부터 여백이
         8px 밑으로 줄어든다). CoreUiBuilder.cs 의 RailKeyHeight 와 반드시 같이 바꿔야 한다.

         F각인/라벨 줄간격 : 예전엔 라벨을 버튼 전체 높이에서 세로중앙 정렬했는데,
         2줄로 접히는 긴 라벨(예 "MISSION DATA LOG")은 중앙정렬 계산상 첫 줄이
         F각인 바로 아래까지 올라와 "거의 붙어보였다" - Grid.RowDefinitions 로
         F각인 전용 행(28)을 다시 떼어내고, 라벨은 그 아래 남은 공간에서만
         세로중앙 정렬한다(최소 8px 는 항상 비게 된다).
    ══════════════════════════════════════════════════════════ -->

    <Style x:Key="SideSoftButtonStyle" TargetType="{x:Type ctl:SoftButton}">
        <!-- 165 가 아니라 153 : Application 왼쪽/오른쪽 경계까지 12px 여백 확보
             (8→20px 로 넓혔다가 "너무 넓다" 피드백으로 12px 로 다시 줄였다.
             X 좌표는 그대로 두고 폭만 줄인다) -->
        <Setter Property="Width" Value="153"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="FontFamily" Value="{StaticResource GvaFont}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:SoftButton}">
                    <Grid>
                        <Border x:Name="Root"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="{StaticResource SurfaceEnableBrush}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- F각인 : 전용 행 우측 상단, mono -->
                                <TextBlock x:Name="KeyIdText" Grid.Row="0"
                                           Text="{TemplateBinding KeyId}"
                                           FontFamily="{StaticResource GvaMonoFont}"
                                           FontSize="18"
                                           Foreground="{StaticResource ForegroundDimBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"/>

                                <!-- 라벨 : 좌측 정렬, 최대 2줄, F각인 행 아래 남은 공간에서 세로 중앙 -->
                                <TextBlock x:Name="LabelText" Grid.Row="1"
                                           Text="{TemplateBinding Label}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           LineHeight="22" LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="44"
                                           TextAlignment="Left"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 상단 1px 흰색 하이라이트 (7%) - 브러시드 메탈 위의 미세한 반사 -->
                        <Border x:Name="Highlight"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="{StaticResource SoftKeyHighlightCornerRadius}"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"/>

                        <!--
                            Selected 액센트 엣지 : 글로우 대신 좌측 3px 솔리드 바 하나로만 강조한다.
                            블러/이펙트가 전혀 없으므로 텍스트가 흐려질 일도 없다.
                        -->
                        <Border x:Name="AccentEdge"
                                Width="3" HorizontalAlignment="Left"
                                Margin="2,6,0,6"
                                CornerRadius="2"
                                Background="{StaticResource AccentBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"/>

                        <!-- Disable 해치 : 대각선 패턴으로 "사용 불가"를 명시한다 -->
                        <Border x:Name="DisabledHatch"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="{StaticResource DisabledHatchBrush}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>

                        <!-- 조작 피드백 오버레이 -->
                        <Border x:Name="Overlay"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="#FFFFFF" Opacity="0"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="SoftButtonSelected">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceSelectedBrush}"/>
                            <Setter TargetName="KeyIdText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="AccentEdge" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
                        </Trigger>

                        <!--
                            Disable : 명도를 낮추는 것에 더해 해치 오버레이로 "사용 불가"를 표기한다.
                            어둡게 숨기기만 하지 않는다.
                        -->
                        <Trigger Property="State" Value="SoftButtonDisabled">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceOffBrush}"/>
                            <Setter TargetName="KeyIdText" Property="Foreground" Value="{StaticResource ForegroundOffBrush}"/>
                            <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DisabledHatch" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundOffBrush}"/>
                        </Trigger>

                        <!-- Hidden : 화면에서 통째로 사라진다(자리도 차지하지 않는다) -
                             현재 이 물리 버튼에 배정된 기능이 없을 때. -->
                        <Trigger Property="State" Value="SoftButtonHidden">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="State" Value="SoftButtonEnabled"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.05"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="State" Value="SoftButtonSelected"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.06"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="State" Value="SoftButtonEnabled"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         F7~F12 (우측 레일) : SideSoftButtonStyle 과 동일 크기·상태 로직,
         라벨만 우측 정렬 + Selected 액센트 엣지만 우측으로 미러링.
         (F각인 위치는 그대로 - 요청받은 두 가지만 바꾼다)
    ══════════════════════════════════════════════════════════ -->

    <Style x:Key="SideSoftButtonRightStyle" TargetType="{x:Type ctl:SoftButton}">
        <!-- SideSoftButtonStyle 과 같은 이유로 153/100 (Application 오른쪽 경계까지
             12px, 높이는 하단 열과 8px 여백을 지키는 사실상 최댓값) -->
        <Setter Property="Width" Value="153"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="FontFamily" Value="{StaticResource GvaFont}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:SoftButton}">
                    <Grid>
                        <Border x:Name="Root"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="{StaticResource SurfaceEnableBrush}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- F각인은 좌측 레일과 동일하게 전용 행에 둔다 - "F10 이랑
                                     라벨이 거의 붙어있다" 피드백(2줄 라벨의 세로중앙 정렬이
                                     F각인 행까지 올라왔던 문제)을 여기도 같이 고친다. -->
                                <TextBlock x:Name="KeyIdText" Grid.Row="0"
                                           Text="{TemplateBinding KeyId}"
                                           FontFamily="{StaticResource GvaMonoFont}"
                                           FontSize="18"
                                           Foreground="{StaticResource ForegroundDimBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"/>

                                <!-- 라벨 : 우측 정렬 (좌측 레일과의 유일한 차이 1) -->
                                <TextBlock x:Name="LabelText" Grid.Row="1"
                                           Text="{TemplateBinding Label}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           LineHeight="22" LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="44"
                                           TextAlignment="Right"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="Highlight"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="{StaticResource SoftKeyHighlightCornerRadius}"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"/>

                        <!-- Selected 액센트 엣지 : 우측 (좌측 레일과의 유일한 차이 2) -->
                        <Border x:Name="AccentEdge"
                                Width="3" HorizontalAlignment="Right"
                                Margin="0,6,2,6"
                                CornerRadius="2"
                                Background="{StaticResource AccentBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"/>

                        <Border x:Name="DisabledHatch"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="{StaticResource DisabledHatchBrush}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>

                        <Border x:Name="Overlay"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="#FFFFFF" Opacity="0"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="SoftButtonSelected">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceSelectedBrush}"/>
                            <Setter TargetName="KeyIdText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="AccentEdge" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
                        </Trigger>

                        <Trigger Property="State" Value="SoftButtonDisabled">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceOffBrush}"/>
                            <Setter TargetName="KeyIdText" Property="Foreground" Value="{StaticResource ForegroundOffBrush}"/>
                            <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DisabledHatch" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundOffBrush}"/>
                        </Trigger>

                        <!-- Hidden : 화면에서 통째로 사라진다(자리도 차지하지 않는다) -
                             현재 이 물리 버튼에 배정된 기능이 없을 때. -->
                        <Trigger Property="State" Value="SoftButtonHidden">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="State" Value="SoftButtonEnabled"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.05"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="State" Value="SoftButtonSelected"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.06"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="State" Value="SoftButtonEnabled"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         F13~F20 : 하단 소프트키  214 x 56
         F각인 우측 상단 / 라벨 가운데 정렬 최대 2줄
    ══════════════════════════════════════════════════════════ -->

    <Style x:Key="BottomSoftButtonStyle" TargetType="{x:Type ctl:SoftButton}">
        <Setter Property="Width" Value="214"/>
        <!-- 56 이 아니라 48 : "높이가 너무 작다" 피드백으로 40→48 로 다시 키웠다.
             Application 아래쪽 경계까지 8px(16px 였다가 다시 줄임), 화면 하단까지는
             기존대로 4px 여백(48 + 8 + 4 = 60, 남는 공간과 일치) -->
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontFamily" Value="{StaticResource GvaFont}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:SoftButton}">
                    <Grid>
                        <Border x:Name="Root"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="{StaticResource SurfaceEnableBrush}">
                            <Grid>
                                <!-- 아이콘 없이 라벨만 가운데 정렬 (하단 열은 SVG 아이콘을 쓰지 않는다) -->
                                <TextBlock x:Name="LabelText"
                                           Text="{TemplateBinding Label}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           LineHeight="22" LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="44"
                                           TextAlignment="Center"
                                           Margin="16,0,16,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <TextBlock x:Name="KeyIdText"
                                           Text="{TemplateBinding KeyId}"
                                           FontFamily="{StaticResource GvaMonoFont}"
                                           FontSize="18"
                                           Foreground="{StaticResource ForegroundDimBrush}"
                                           Margin="0,8,8,0"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <Border x:Name="Highlight"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="{StaticResource SoftKeyHighlightCornerRadius}"
                                IsHitTestVisible="False"/>

                        <!-- Selected 액센트 엣지 : 상단 3px 솔리드 바. 하단 열이라 위쪽에 배치한다 -->
                        <Border x:Name="AccentEdge"
                                Height="3" VerticalAlignment="Top"
                                Margin="6,2,6,0"
                                CornerRadius="2"
                                Background="{StaticResource AccentBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"/>

                        <Border x:Name="DisabledHatch"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="{StaticResource DisabledHatchBrush}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>

                        <Border x:Name="Overlay"
                                CornerRadius="{StaticResource SoftKeyCornerRadius}"
                                Background="#FFFFFF" Opacity="0"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="SoftButtonSelected">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceSelectedBrush}"/>
                            <Setter TargetName="KeyIdText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="AccentEdge" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
                        </Trigger>

                        <Trigger Property="State" Value="SoftButtonDisabled">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceOffBrush}"/>
                            <Setter TargetName="KeyIdText" Property="Foreground" Value="{StaticResource ForegroundOffBrush}"/>
                            <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DisabledHatch" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundOffBrush}"/>
                        </Trigger>

                        <!-- Hidden : 화면에서 통째로 사라진다(자리도 차지하지 않는다) -
                             현재 이 물리 버튼에 배정된 기능이 없을 때. -->
                        <Trigger Property="State" Value="SoftButtonHidden">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="State" Value="SoftButtonEnabled"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.05"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="State" Value="SoftButtonSelected"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.06"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="State" Value="SoftButtonEnabled"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            <Setter TargetName="Overlay" Property="Opacity" Value="0"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         기능영역 라벨(TopLabel) 8개 : 히트타겟 183 x 20, 텍스트 없음
         상단 하드웨어 버튼 8개(SA/WPN/DEF/SYS/DRV/STR/COM/SMS) 대응 예정

         F1~F20(SoftButton/SoftButtonState)과는 다른 컨트롤·다른 상태 모델이다 -
         기존에 쓰던 호출 규약(T_Button_State, SetLabelState)을 그대로 따른다.
         LabelStateSelectedLeft/LabelStateSeletedRight 는 트랙 바를 반쪽만 칠한다
         (Left=왼쪽 반쪽, Right=오른쪽 반쪽) - 그래서 트랙 바 자체를 가운데서 둘로
         나눈 LeftHalf/RightHalf 두 조각으로 만들었다. 둘 다 같은 색이면 이음매 없는
         바 하나로 보인다(가운데만 각지고 바깥쪽만 둥글게 잘라서 붙였다).

         "너무 두껍고 무거워 보인다" / "Enable 이 잘 안 보인다" 피드백은 F1~F20 과
         동일하게 반영돼 있다(20px 히트타겟 중 6px 트랙 바만 칠함, Enable 도
         ForegroundDimBrush 로 또렷하게).
    ══════════════════════════════════════════════════════════ -->

    <Style x:Key="TopLabelStyle" TargetType="{x:Type ctl:TopLabel}">
        <Setter Property="Width" Value="183"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:TopLabel}">
                    <Grid>
                        <!-- 히트타겟은 183x20 전체 (투명 - 클릭 영역만 확보) -->
                        <Border Background="Transparent"/>

                        <!-- 실제로 보이는 부분 : 가운데의 얇은 트랙 바를 반으로 나눈
                             두 조각. Enable 상태도 또렷이 보이도록 불투명한 중간
                             밝기 회색을 기본값으로 쓴다. -->
                        <Grid Height="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="LeftHalf" Grid.Column="0"
                                    CornerRadius="{StaticResource TopLabelLeftCornerRadius}"
                                    Background="{StaticResource ForegroundDimBrush}"/>
                            <Border x:Name="RightHalf" Grid.Column="1"
                                    CornerRadius="{StaticResource TopLabelRightCornerRadius}"
                                    Background="{StaticResource ForegroundDimBrush}"/>
                        </Grid>

                        <Border x:Name="DisabledHatch"
                                Height="6" VerticalAlignment="Center"
                                CornerRadius="{StaticResource FunctionLabelCornerRadius}"
                                Background="{StaticResource DisabledHatchBrush}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 전체 선택 : 양쪽 다 액센트 색 -->
                        <Trigger Property="State" Value="LabelStateSelected">
                            <Setter TargetName="LeftHalf" Property="Background" Value="{StaticResource LabelSelectedBrush}"/>
                            <Setter TargetName="RightHalf" Property="Background" Value="{StaticResource LabelSelectedBrush}"/>
                        </Trigger>

                        <!-- 왼쪽 반쪽만 색칠 - 오른쪽은 Enable 기본색 그대로 둔다 -->
                        <Trigger Property="State" Value="LabelStateSelectedLeft">
                            <Setter TargetName="LeftHalf" Property="Background" Value="{StaticResource LabelSelectedBrush}"/>
                        </Trigger>

                        <!-- 오른쪽 반쪽만 색칠 - 왼쪽은 Enable 기본색 그대로 둔다 -->
                        <Trigger Property="State" Value="LabelStateSeletedRight">
                            <Setter TargetName="RightHalf" Property="Background" Value="{StaticResource LabelSelectedBrush}"/>
                        </Trigger>

                        <Trigger Property="State" Value="LabelStateDisabled">
                            <Setter TargetName="LeftHalf" Property="Background" Value="{StaticResource SurfaceOffBrush}"/>
                            <Setter TargetName="RightHalf" Property="Background" Value="{StaticResource SurfaceOffBrush}"/>
                            <Setter TargetName="LeftHalf" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="RightHalf" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="DisabledHatch" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="State" Value="LabelStateEnabled"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LeftHalf" Property="Background" Value="{StaticResource ForegroundBrush}"/>
                            <Setter TargetName="RightHalf" Property="Background" Value="{StaticResource ForegroundBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        전시영역 카드(Application) 스타일은 더 이상 여기 없다 - Application 이
        별도 프로세스가 되면서 CardTitleStyle/CardCodeStyle/HeroValueStyle/
        HeroUnitStyle/RowKeyStyle/RowValueStyle 은 그쪽 프로젝트
        (GVA.HMI.Example.Application/Themes) 로 옮겼다. Core 는 Application
        내용을 전혀 그리지 않으므로 가질 필요가 없다.
    -->

</ResourceDictionary>
