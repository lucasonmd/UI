<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="VoidColor">#FF000000</Color>

    <Color x:Key="ChassisHiColor">#FF1A1B1E</Color>
    <Color x:Key="ChassisLoColor">#FF101012</Color>

    <Color x:Key="SurfaceHiColor">#FF232326</Color>
    <Color x:Key="SurfaceLoColor">#FF1A1A1D</Color>
    <Color x:Key="SurfaceOffColor">#FF141416</Color>

    <Color x:Key="ForegroundColor">#FFF2F2F2</Color>
    <Color x:Key="ForegroundDimColor">#FF8A9096</Color>
    <Color x:Key="ForegroundOffColor">#FF4E4E52</Color>

    <Color x:Key="AccentColor">#FF00C8FF</Color>
    <Color x:Key="AccentDeepColor">#FF0098D4</Color>
    <Color x:Key="AccentForegroundColor">#FFEAF9FF</Color>
    <Color x:Key="SelectedHiColor">#FF0C3A4B</Color>
    <Color x:Key="SelectedLoColor">#FF082530</Color>

    <Color x:Key="WarningColor">#FFFF453A</Color>
    <Color x:Key="CautionColor">#FFFFB300</Color>
    <Color x:Key="NormalColor">#FF32D74B</Color>

    <Color x:Key="HairlineColor">#12FFFFFF</Color>
    <Color x:Key="FrameSeamColor">#1FFFFFFF</Color>

    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}"/>

    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="ForegroundDimBrush" Color="{StaticResource ForegroundDimColor}"/>
    <SolidColorBrush x:Key="ForegroundOffBrush" Color="{StaticResource ForegroundOffColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}"/>

    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}"/>
    <SolidColorBrush x:Key="NormalBrush" Color="{StaticResource NormalColor}"/>

    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}"/>
    <SolidColorBrush x:Key="FrameSeamBrush" Color="{StaticResource FrameSeamColor}"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#0FFFFFFF"/>

    <SolidColorBrush x:Key="SurfaceOffBrush" Color="{StaticResource SurfaceOffColor}"/>

    <LinearGradientBrush x:Key="SurfaceEnableBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource SurfaceHiColor}"/>
        <GradientStop Offset="1" Color="{StaticResource SurfaceLoColor}"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SurfaceSelectedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource SelectedHiColor}"/>
        <GradientStop Offset="1" Color="{StaticResource SelectedLoColor}"/>
    </LinearGradientBrush>

    <!-- 선택 : 윗변에 거의 흰 청록을 얹어 "불이 들어온 램프"로 만든다. 평균 휘도만
         올리는 것보다 이 하이라이트 한 줄이 선택 여부를 훨씬 즉각적으로 읽히게 한다.
         활성(중성 회색)과는 채도로도 갈리므로 색상·휘도 두 축에서 모두 앞선다. -->
    <LinearGradientBrush x:Key="LabelSelectedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFCFF6FF"/>
        <GradientStop Offset="0.35" Color="#FF22D4FF"/>
        <GradientStop Offset="1" Color="#FF00A8E4"/>
    </LinearGradientBrush>

    <!-- 활성 : 평균 휘도를 올리면 선택과 다시 붙어버린다. 대신 윗변 하이라이트를
         좁고(상단 20%) 밝게 몰아 스페큘러처럼 만들고 아랫변을 더 깊게 떨어뜨린다 -
         평균은 그대로인데 "빛을 받는 물체"로 읽혀 훨씬 살아 보인다.
         완전 무채색은 죽은 금속처럼 보여서 아주 약한 쿨 틴트(R<G<B)를 준다. -->
    <LinearGradientBrush x:Key="LabelEnabledBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFCEDCE8"/>
        <GradientStop Offset="0.2" Color="#FF8C9AA8"/>
        <GradientStop Offset="1" Color="#FF4E5C6A"/>
    </LinearGradientBrush>
    <!-- 비활성 : 조명 구조를 아예 빼고(그라데이션 없음) 평면으로 둔다 - 위아래 명암이
         없으면 그 자체로 "꺼진 것"처럼 읽힌다. 다만 검은 캔버스 위 6px 띠라 SoftButton
         의 판(#141416)을 그대로 쓰면 사라지므로, 형태는 남을 만큼만 밝기를 준다. -->
    <SolidColorBrush x:Key="LabelDisabledBrush" Color="#FF34373B"/>

    <LinearGradientBrush x:Key="ChassisBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource ChassisHiColor}"/>
        <GradientStop Offset="1" Color="{StaticResource ChassisLoColor}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatusBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource ChassisHiColor}"/>
        <GradientStop Offset="1" Color="{StaticResource ChassisLoColor}"/>
    </LinearGradientBrush>

    <Color x:Key="EngraveColor">#24000000</Color>
    <SolidColorBrush x:Key="EngraveBrush" Color="{StaticResource EngraveColor}"/>

    <DrawingBrush x:Key="DisabledHatchBrush" TileMode="Tile" Stretch="None"
                  Viewport="0,0,8,8" ViewportUnits="Absolute" Opacity="0.05">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <PathGeometry>
                        <PathFigure StartPoint="0,8" IsClosed="False">
                            <LineSegment Point="8,0"/>
                        </PathFigure>
                    </PathGeometry>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="White" Thickness="1"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="SurfaceEnableFlatBrush" Color="#FF232326"/>
    <SolidColorBrush x:Key="SurfaceSelectedFlatBrush" Color="#FF0A2E3A"/>
    <SolidColorBrush x:Key="LabelSelectedFlatBrush" Color="#FF00B0E8"/>

    <FontFamily x:Key="GvaFont">Segoe UI, Malgun Gothic, Inter, Arial</FontFamily>
    <FontFamily x:Key="GvaMonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>

    <CornerRadius x:Key="SoftKeyCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SoftKeyHighlightCornerRadius">5,5,0,0</CornerRadius>
    <CornerRadius x:Key="FunctionLabelCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="TopLabelLeftCornerRadius">2,0,0,2</CornerRadius>
    <CornerRadius x:Key="TopLabelRightCornerRadius">0,2,2,0</CornerRadius>
    <CornerRadius x:Key="StatusBarCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="FrameCornerRadius">14</CornerRadius>

</ResourceDictionary>
