<!--
    StatusBar : 0, 0 / 1920 x 76 / 라운드 0
    38px 2줄. 값/라벨 최소 18px.

    "기존에 쓰고 있는 바인딩에 맞춘" 재설계 - 항목 구성 자체를 바꿨다(VEH/MSN/MODE
    같은 예전 항목은 없다):
      1줄 : 시간(SystemData.CurrentTime) / 방위각(SystemData.HeadingMil) /
            커스텀 전시정보(JSON, LoadCustomDisplayData 참고)
      2줄 : 좌표(SystemData.Coordinate) / 알람(AlarmData.*, 시간+메세지+카운트
            뱃지, AlarmLevel 로 색이 바뀐다) / 경고·주의·무시 집계

    그룹 사이엔 얇은 Frame 심선(GroupDivider)만 두고, 배경은 Chassis 톤 -
    PanelBrush(Application 전용)와는 다르다(리디자인 원칙 그대로 유지).
-->
<UserControl x:Class="HMICore.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMICore.ViewModels"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:StatusBarViewModel}"
             Width="1920" Height="76">

    <UserControl.Resources>
        <!-- 그룹 내부 항목 간격 28 (8px 그리드의 3.5배 - 24→28, POS 와 같은 이유로
             전체적으로 살짝 더 여유있게) -->
        <Style x:Key="StatusItemStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
        </Style>
        <Style x:Key="StatusItemLastStyle" BasedOn="{StaticResource StatusItemStyle}" TargetType="{x:Type StackPanel}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="GroupStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 그룹 구분선 : 짧은 세로 심선, 좌우 20px 여백(16→20, 전반적으로 더
             여유있게 - "사용 프로그램스럽게" 피드백) -->
        <Style x:Key="GroupDividerStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="{StaticResource FrameSeamBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="20,0,20,0"/>
        </Style>

        <!-- 알람 시간/메세지 : AlarmData.AlarmLevel 이 "경고"/"주의" 일 때만 색이 바뀐다.
             시간은 GvaMonoFont, 메세지는 기본 폰트라 서체별 줄 높이가 달라서 나란히
             두면 세로로 어긋나 보였다 - GvaStyles.xaml 의 StatusLabelStyle 과 같은
             이유·같은 값(LineHeight 28 + BaselineOffset 22)으로 맞춘다. -->
        <Style x:Key="AlarmLevelTextStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="LineHeight" Value="28"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="BaselineOffset" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlarmData.AlarmLevel}" Value="경고">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AlarmData.AlarmLevel}" Value="주의">
                    <Setter Property="Foreground" Value="{StaticResource CautionBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 알람 카운트 뱃지 : 작은 필 하나만 심각도 색으로 채운다(배경 전체를 물들이지
             않는다는 원칙은 유지 - 뱃지처럼 작은 면적만 예외로 허용한다). 텍스트
             LineHeight 가 26→28 로 커진 것과 맞춰 뱃지도 28 로 키웠다. -->
        <Style x:Key="AlarmBadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource ForegroundOffBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlarmData.AlarmLevel}" Value="경고">
                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AlarmData.AlarmLevel}" Value="주의">
                    <Setter Property="Background" Value="{StaticResource CautionBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource StatusBarBrush}"
            CornerRadius="{StaticResource StatusBarCornerRadius}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- ── 1줄 : 시간 / 방위각 / 커스텀 전시정보 ── -->
            <Grid Grid.Row="0" Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource StatusValueStyle}" Margin="0"
                           Text="{Binding SystemData.CurrentTime}"/>

                <Border Grid.Column="1" Style="{StaticResource GroupDividerStyle}"/>

                <StackPanel Grid.Column="2" Style="{StaticResource StatusItemStyle}">
                    <TextBlock Style="{StaticResource StatusLabelStyle}" Text="HDG"/>
                    <TextBlock Style="{StaticResource StatusValueStyle}" Text="{Binding SystemData.HeadingMil}"/>
                </StackPanel>

                <!--
                    커스텀 전시정보 : Key 개수·차지 비율이 JSON(itemWithLayout) 에 따라
                    바뀌므로 정적 ColumnDefinition 으로는 표현이 안 된다 - CustomItems
                    가 바뀔 때마다 StatusBarView.xaml.cs 가 이 Grid 의 열을 새로 만든다.
                -->
                <Grid x:Name="CustomInfoHost" Grid.Column="3" HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- ── 2줄 : 좌표 / 알람 / 경고·주의·무시 집계 ── -->
            <Border Grid.Row="1" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 오른쪽 여백만 기본(28)보다 넓게(36) - "POS 공간 조금 더 여유있게" 피드백,
                     알람/집계 쪽으로 붙어 보이지 않게 POS 그룹만 더 띄운다. -->
                <StackPanel Grid.Column="0" Style="{StaticResource StatusItemStyle}" Margin="0,0,36,0">
                    <TextBlock Style="{StaticResource StatusLabelStyle}" Text="POS"/>
                    <TextBlock Style="{StaticResource StatusValueStyle}" Text="{Binding SystemData.Coordinate}"/>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource GroupDividerStyle}"/>

                <!--
                    알람 : 시간 + 메세지 + 카운트 뱃지. 셋 다 AlarmData.AlarmLevel 로
                    색이 바뀐다. StackPanel 이 아니라 Grid(Auto/*/Auto) 를 쓰는 이유 -
                    메세지 길이에 따라 뱃지가 같이 밀리지 않고 항상 이 열의 오른쪽
                    끝에 고정돼야 한다("뱃지는 우측 고정" 피드백). 메세지는 가운데
                    * 열을 꽉 채우고 넘치면 말줄임표로 잘린다.
                -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="AlarmMessageTime" Grid.Column="0" Style="{StaticResource AlarmLevelTextStyle}"
                               FontFamily="{StaticResource GvaMonoFont}" Margin="0,0,16,0"
                               Text="{Binding AlarmData.AlarmTime}"/>
                    <TextBlock x:Name="AlarmMessageText" Grid.Column="1" Style="{StaticResource AlarmLevelTextStyle}"
                               Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                               Text="{Binding AlarmData.AlarmMessage}"/>
                    <Border Grid.Column="2" Style="{StaticResource AlarmBadgeStyle}">
                        <TextBlock Text="{Binding AlarmData.AlarmCount}"
                                   FontFamily="{StaticResource GvaMonoFont}" FontSize="21"
                                   FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 경고 / 주의 / 무시 집계 -->
                <StackPanel Grid.Column="3" Style="{StaticResource GroupStyle}">
                    <Border Style="{StaticResource GroupDividerStyle}"/>
                    <StackPanel Style="{StaticResource StatusItemStyle}">
                        <TextBlock Style="{StaticResource TallyStyle}"
                                   Foreground="{StaticResource ForegroundDimBrush}" Text="WARN"/>
                        <TextBlock Style="{StaticResource TallyStyle}" Margin="10,0,0,0"
                                   Foreground="{StaticResource WarningBrush}" Text="{Binding AlarmData.WarningCount}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatusItemStyle}">
                        <TextBlock Style="{StaticResource TallyStyle}"
                                   Foreground="{StaticResource ForegroundDimBrush}" Text="CAUT"/>
                        <TextBlock Style="{StaticResource TallyStyle}" Margin="10,0,0,0"
                                   Foreground="{StaticResource CautionBrush}" Text="{Binding AlarmData.CautionCount}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatusItemLastStyle}">
                        <TextBlock Style="{StaticResource TallyStyle}"
                                   Foreground="{StaticResource ForegroundDimBrush}" Text="IGN"/>
                        <TextBlock Style="{StaticResource TallyStyle}" Margin="10,0,0,0"
                                   Foreground="{StaticResource ForegroundDimBrush}" Text="{Binding AlarmData.IgnoreCount}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
