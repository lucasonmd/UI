<UserControl x:Class="HMICore.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMICore.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StatusBarViewModel}"
             Width="1920" Height="116">

    <UserControl.Resources>
        <Style x:Key="StatusLabelStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="LineHeight" Value="32"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="BaselineOffset" Value="25"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatusValueStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource GvaMonoFont}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="32"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="BaselineOffset" Value="25"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CustomValueStyle" BasedOn="{StaticResource StatusValueStyle}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource GvaFont}"/>
        </Style>
        <Style x:Key="TallyStyle" BasedOn="{StaticResource StatusValueStyle}" TargetType="{x:Type TextBlock}"/>

        <Style x:Key="StatusSegmentStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CustomStatusItemStyle" BasedOn="{StaticResource StatusSegmentStyle}" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="AlertBandStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource ForegroundOffBrush}"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlarmData.AlarmLevel}" Value="경고">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AlarmData.AlarmLevel}" Value="주의">
                    <Setter Property="BorderBrush" Value="{StaticResource CautionBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AlarmTextStyle" BasedOn="{StaticResource StatusValueStyle}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlarmData.AlarmLevel}" Value="경고">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AlarmData.AlarmLevel}" Value="주의">
                    <Setter Property="Foreground" Value="{StaticResource CautionBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AlarmBadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="{StaticResource ForegroundOffBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlarmData.AlarmLevel}" Value="경고">
                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AlarmData.AlarmLevel}" Value="주의">
                    <Setter Property="Background" Value="{StaticResource CautionBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TallyCellStyle" BasedOn="{StaticResource StatusSegmentStyle}" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="132"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="TallyCellLastStyle" BasedOn="{StaticResource TallyCellStyle}" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource StatusBarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatusSegmentStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StatusLabelStyle}" Text="TIME" Margin="0,0,12,0"/>
                            <TextBlock Style="{StaticResource StatusValueStyle}" Text="{Binding SystemData.CurrentTime}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatusSegmentStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StatusLabelStyle}" Text="HDG" Margin="0,0,12,0"/>
                            <TextBlock Style="{StaticResource StatusValueStyle}" Text="{Binding SystemData.HeadingMil}"/>
                        </StackPanel>
                    </Border>
                    <Grid x:Name="CustomInfoHost" Grid.Column="4" HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatusSegmentStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource StatusLabelStyle}" Text="POS" Margin="0,0,12,0"/>
                        <TextBlock Style="{StaticResource StatusValueStyle}" Text="{Binding SystemData.Coordinate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource AlertBandStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource StatusLabelStyle}" Text="ALERT" Margin="0,0,14,0"/>
                        <TextBlock x:Name="AlarmMessageTime" Grid.Column="1" Style="{StaticResource AlarmTextStyle}"
                                   FontFamily="{StaticResource GvaMonoFont}" Margin="0,0,16,0"
                                   Text="{Binding AlarmData.AlarmTime}"/>
                        <TextBlock x:Name="AlarmMessageText" Grid.Column="2" Style="{StaticResource AlarmTextStyle}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,14,0"
                                   Text="{Binding AlarmData.AlarmMessage}"/>
                        <Border Grid.Column="3" Style="{StaticResource AlarmBadgeStyle}">
                            <TextBlock Text="{Binding AlarmData.AlarmCount}" FontFamily="{StaticResource GvaMonoFont}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource TallyCellStyle}">
                        <Grid>
                            <TextBlock Style="{StaticResource StatusLabelStyle}" Text="WARN" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource TallyStyle}" Text="{Binding AlarmData.WarningCount}"
                                       Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource TallyCellStyle}">
                        <Grid>
                            <TextBlock Style="{StaticResource StatusLabelStyle}" Text="CAUT" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource TallyStyle}" Text="{Binding AlarmData.CautionCount}"
                                       Foreground="{StaticResource CautionBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource TallyCellLastStyle}">
                        <Grid>
                            <TextBlock Style="{StaticResource StatusLabelStyle}" Text="IGN" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource TallyStyle}" Text="{Binding AlarmData.IgnoreCount}"
                                       Foreground="{StaticResource ForegroundDimBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
