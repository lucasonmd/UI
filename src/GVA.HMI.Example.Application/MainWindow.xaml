<!--
    GVA HMI Application - 1590 x 915

    Core(GVA.HMI.Example.Core.exe)의 "Application 영역" 자리를 채우는 별도 프로세스.
    Core 가 owner 인자(HWND 값)로 자기 창 핸들을 넘겨주면, Interop/OwnerWindowSync 가
    그 창 위에 정확히 겹쳐 앉고(Win32 owner 관계) 이동/리사이즈를 계속 따라간다.

    owner 인자가 없으면(이 프로젝트만 단독 실행) 그냥 보통 창처럼 가운데에,
    크기 조절 가능하게 뜬다 - 이 화면만 따로 확인하고 싶을 때 쓰라고 일부러 둔 경로다.
-->
<Window x:Class="GVA.HMI.Example.Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GVA.HMI.Example.Application.Views"
        xmlns:vm="clr-namespace:GVA.HMI.Example.Application.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:ApplicationViewModel}"
        Title="GVA HMI Application — 1590 × 915"
        Width="1590" Height="915"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource VoidBrush}">

    <!-- Core 와 같은 이유로 UseLayoutRounding 을 켜지 않는다(카드 CornerRadius 가 있으므로
         Viewbox 비정수 축소와 만나면 모서리가 깨질 수 있다 - Core 에서 겪은 문제와 동일). -->
    <Viewbox Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
        <views:ApplicationAreaView/>
    </Viewbox>
</Window>
