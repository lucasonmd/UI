<!--
    GVA HMI Application - 색상 팔레트

    이 값들은 원래 Core 프로젝트의 GvaColors.xaml 에 "Application 전용 - 손대지
    않는다" 로 표시돼 있던 것을 그대로 옮겨왔다. Core 가 이 값들을 바꾸지 않았듯,
    Core 쪽 Chassis/Surface/Accent 계열 재설계(premium embedded HMI)도 이 파일에는
    영향을 주지 않는다 - 두 프로세스가 각자 자기 팔레트를 갖는다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="VoidColor">#FF000000</Color>
    <Color x:Key="PanelColor">#FF191919</Color>
    <Color x:Key="TitleBarHiColor">#FF333336</Color>
    <Color x:Key="TitleBarLoColor">#FF2B2B2B</Color>

    <Color x:Key="ForegroundColor">#FFF2F2F2</Color>
    <Color x:Key="ForegroundDimColor">#FF8A9096</Color>

    <!-- Warning / Caution / Normal - Core 의 StatusBar 도 같은 값을 쓰지만, 완전히
         독립된 두 프로세스이므로 각자 정의한다(디자인 토큰만 같을 뿐 리소스 공유는 아니다). -->
    <Color x:Key="WarningColor">#FFFF453A</Color>
    <Color x:Key="CautionColor">#FFFFB300</Color>
    <Color x:Key="NormalColor">#FF32D74B</Color>

    <!-- ══ Brushes ═════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>

    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="ForegroundDimBrush" Color="{StaticResource ForegroundDimColor}"/>
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="{StaticResource ForegroundColor}"/>

    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}"/>
    <SolidColorBrush x:Key="NormalBrush" Color="{StaticResource NormalColor}"/>

    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#0EFFFFFF"/>

    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource TitleBarHiColor}"/>
        <GradientStop Offset="1" Color="{StaticResource TitleBarLoColor}"/>
    </LinearGradientBrush>

    <!-- ══ 치수 / 타이포 ═══════════════════════════════════════ -->

    <FontFamily x:Key="GvaFont">Segoe UI, Inter, Arial</FontFamily>
    <FontFamily x:Key="GvaMonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>

    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

</ResourceDictionary>
