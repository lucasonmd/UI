<!--
    GVA HMI Application - 스타일

    Core 의 GvaStyles.xaml 에 있던 "전시영역 카드" 스타일 6개를 그대로 옮겨왔다 -
    Application 은 재설계 대상이 아니라서 값은 손대지 않았다(폰트 최소 18px 포함).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GvaTextBase" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource GvaFont}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         전시영역 카드 : 라운드 12
    ══════════════════════════════════════════════════════════ -->

    <Style x:Key="CardTitleStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CardCodeStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource GvaMonoFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeroValueStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource GvaMonoFont}"/>
        <Setter Property="FontSize" Value="64"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="HeroUnitStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <Style x:Key="RowKeyStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}"/>
    </Style>

    <Style x:Key="RowValueStyle" BasedOn="{StaticResource GvaTextBase}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource GvaMonoFont}"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>

</ResourceDictionary>
